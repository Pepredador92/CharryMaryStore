<section class="page-band" data-support-workspace>
  <div class="page-inner">
    <div class="page-heading"><div><span class="section-kicker">Atención privada</span><h1>Habla con Mary</h1><p>Cuéntanos qué necesitas y continuaremos la conversación aquí.</p></div></div>

    <div data-support-public>
      <form class="panel form-grid support-public-form" data-support-form data-support-mode="public">
        <label class="wide">Asunto<input name="subject" required maxlength="160" /></label>
        <label>Correo electrónico<input name="email" type="email" autocomplete="email" /></label>
        <label>Teléfono<input name="phone" type="tel" autocomplete="tel" /></label>
        <label class="wide">Mensaje<textarea name="body" required maxlength="4000" placeholder="Escribe tu mensaje para Mary..."></textarea></label>
        <label class="check-field wide"><input type="checkbox" name="sensitive" /> Contiene información sensible</label>
        <div class="form-actions wide"><button class="button primary" type="submit">Enviar a Mary</button></div>
        <div class="notice wide" data-support-message hidden role="status"></div>
      </form>
    </div>

    <div class="support-chat-shell" data-support-auth hidden>
      <aside class="support-inbox" aria-label="Conversaciones">
        <header>
          <div><span>Mensajes</span><strong>Mary</strong></div>
          <button class="icon-button" type="button" data-new-chat title="Iniciar conversación" aria-label="Iniciar conversación">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg>
          </button>
        </header>
        <div class="support-conversation-list" data-my-support-list></div>
      </aside>

      <section class="support-thread" aria-live="polite">
        <header class="support-thread-header" data-thread-header hidden></header>
        <div class="support-thread-empty" data-thread-empty>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4Z"/></svg>
          <strong>Tu espacio con Mary</strong>
          <span>Elige una conversación o inicia una nueva.</span>
        </div>
        <div class="support-message-list" data-chat-messages hidden></div>
        <form class="support-composer" data-chat-reply hidden>
          <textarea name="body" required maxlength="4000" rows="1" aria-label="Mensaje" placeholder="Escribe un mensaje..."></textarea>
          <button class="chat-send-button" type="submit" title="Enviar mensaje" aria-label="Enviar mensaje">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
          </button>
        </form>
        <div class="support-thread-closed notice" data-thread-closed hidden>Esta conversación está cerrada. Puedes iniciar una nueva si necesitas más ayuda.</div>
      </section>
    </div>

    <div class="notice" data-support-error hidden role="alert"></div>
  </div>

  <dialog class="support-new-dialog" data-new-chat-dialog>
    <form class="panel form-grid" data-support-form data-support-mode="account">
      <div class="wide support-dialog-heading"><div><span class="section-kicker">Nueva conversación</span><h2>Escríbele a Mary</h2></div><button class="icon-button" type="button" data-close-new-chat aria-label="Cerrar">×</button></div>
      <label class="wide">Asunto<input name="subject" required maxlength="160" /></label>
      <label class="wide">Mensaje<textarea name="body" required maxlength="4000" placeholder="Escribe tu mensaje para Mary..."></textarea></label>
      <label class="check-field wide"><input type="checkbox" name="sensitive" /> Contiene información sensible</label>
      <div class="form-actions wide"><button class="button" type="button" data-close-new-chat>Cancelar</button><button class="button primary" type="submit">Iniciar conversación</button></div>
      <div class="notice wide" data-support-message hidden role="status"></div>
    </form>
  </dialog>
</section>

<script>
  import '../../scripts/support-page';
</script>
