---
interface Props {
  mode: 'home' | 'products' | 'product-detail' | 'packages' | 'package-detail' | 'cart';
}

const { mode } = Astro.props;
const headings = {
  products: ['Productos', 'Elige una Presentacion vendible; cada variante conserva su propio precio, SKU y disponibilidad.'],
  packages: ['Paquetes', 'Combinaciones preparadas cuya disponibilidad se calcula desde sus componentes.'],
  cart: ['Tu carrito', 'Revisamos precios y disponibilidad antes de crear el Pedido.'],
};
---

<div data-storefront-app data-mode={mode}>
  {mode === 'home' && (
    <>
      <section class="home-hero">
        <div class="home-hero-content">
          <span class="hero-kicker">Bienestar intimo, a tu manera</span>
          <h1>Cherry Mary</h1>
          <p>Encuentra productos elegidos para conocerte, disfrutar y explorar con confianza.</p>
          <div class="button-row">
            <a class="button primary" href="/productos">Descubrir productos</a>
            <a class="button secondary" href="/paquetes">Ver paquetes</a>
          </div>
        </div>
      </section>
      <section class="discovery-section">
        <div class="page-inner">
          <div class="discovery-heading">
            <span class="section-kicker">Encuentra tu camino</span>
            <h2>Tu curiosidad abre nuevas formas de disfrutar</h2>
          </div>
          <div class="discovery-grid">
            <article class="discovery-card">
              <img src="/images/discover-first.jpg" alt="Escultura roja sobre un pedestal rosa" loading="lazy" />
              <div class="discovery-card-copy">
                <h3>Mi primera eleccion</h3>
                <p>Empezar a explorar</p>
                <a class="button category-button" href="/descubrir/mi-primera-eleccion">Descubrir</a>
              </div>
            </article>
            <article class="discovery-card">
              <img src="/images/discover-solo.jpg" alt="Espejo rosa con cerezas y liston verde" loading="lazy" />
              <div class="discovery-card-copy">
                <h3>De mi, para mi</h3>
                <p>Disfrutar a mi ritmo</p>
                <a class="button category-button" href="/descubrir/de-mi-para-mi">Ver productos</a>
              </div>
            </article>
            <article class="discovery-card">
              <img src="/images/discover-together.jpg" alt="Esculturas roja y verde entrelazadas" loading="lazy" />
              <div class="discovery-card-copy">
                <h3>Explorando juntos</h3>
                <p>Descubrir en pareja</p>
                <a class="button category-button" href="/descubrir/explorando-juntos">Ver selección</a>
              </div>
            </article>
            <article class="discovery-card">
              <img src="/images/discover-new.jpg" alt="Esculturas de colores en equilibrio" loading="lazy" />
              <div class="discovery-card-copy">
                <h3>Nuevas sensaciones</h3>
                <p>Probar algo diferente</p>
                <a class="button category-button" href="/descubrir/nuevas-sensaciones">Explorar</a>
              </div>
            </article>
          </div>
        </div>
      </section>
      <section class="page-band white">
        <div class="page-inner">
          <div class="page-heading">
            <div><span class="section-kicker">Para empezar</span><h2>Favoritos para descubrir</h2><p>Una seleccion vigente del catalogo Cherry Mary.</p></div>
            <a class="section-link" href="/productos">Ver todo <span aria-hidden="true">&rarr;</span></a>
          </div>
          <div class="catalog-grid" data-home-featured></div>
        </div>
      </section>
    </>
  )}

  {(mode === 'products' || mode === 'packages') && (
    <section class="page-band">
      <div class="page-inner">
        <div class="page-heading">
          <div><span class="section-kicker">Catalogo Cherry Mary</span><h1>{headings[mode][0]}</h1><p>{headings[mode][1]}</p></div>
        </div>
        <nav class="catalog-tabs" aria-label="Secciones del catalogo">
          <a class:list={{ active: mode === 'products' }} href="/productos">Productos</a>
          <a class:list={{ active: mode === 'packages' }} href="/paquetes">Paquetes</a>
        </nav>
        <div class="catalog-toolbar">
          <label>Buscar<input type="search" placeholder="Nombre o descripcion" data-catalog-search /></label>
          <label>Clasificacion<select data-classification-filter><option value="">Todas</option></select></label>
        </div>
        <div class="catalog-grid" data-catalog-list></div>
      </div>
    </section>
  )}

  {(mode === 'product-detail' || mode === 'package-detail') && (
    <section class="page-band white">
      <div class="page-inner" data-detail-content>
        <div class="state-box"><div><strong>Cargando detalle</strong>Consultando el catalogo vigente.</div></div>
      </div>
    </section>
  )}

  {mode === 'cart' && (
    <section class="page-band">
      <div class="page-inner">
        <div class="page-heading">
          <div><h1>{headings.cart[0]}</h1><p>{headings.cart[1]}</p></div>
        </div>
        <div class="cart-layout">
          <section class="panel" data-cart-lines>
            <div class="state-box"><div><strong>Cargando carrito</strong>Revalidando articulos.</div></div>
          </section>
          <aside class="panel cart-summary">
            <h2>Resumen</h2>
            <div class="summary-row"><span>Subtotal provisional</span><strong data-cart-total>$0.00</strong></div>
            <div class="summary-row total"><span>Total provisional</span><strong data-cart-total>$0.00</strong></div>
            <p class="summary-note">Los precios se confirman en el servidor al crear el Pedido. No es una reserva de inventario.</p>
            <a class="button primary" href="/checkout" data-checkout-link>Continuar al checkout</a>
          </aside>
        </div>
      </div>
    </section>
  )}

  <div class="shell-notice" data-page-notice hidden role="status"></div>
</div>

<script>
  import '../../scripts/storefront';
</script>
